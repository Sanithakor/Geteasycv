// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerified         DateTime?
  password              String?
  name                  String
  avatar                String?
  
  // OAuth
  googleId              String?   @unique
  githubId              String?   @unique
  
  // Profile
  profile               UserProfile?
  
  // Subscription & Billing
  subscription          Subscription?
  subscriptionTier      String    @default("free") // free, pro, premium
  payments              Payment[]
  
  // Content
  resumes               Resume[]
  templates             Template[]
  favorites             FavoriteTemplate[]
  
  // Admin & Roles
  role                  String    @default("user") // user, admin, editor, support
  permissions           String[]  @default([])
  
  // Activity
  activityLogs          ActivityLog[]
  
  // Sessions
  sessions              Session[]
  
  // Support
  supportTickets        SupportTicket[]
  
  // Metadata
  lastLoginAt           DateTime?
  isActive              Boolean   @default(true)
  isBanned              Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([email])
  @@index([subscriptionTier])
  @@index([role])
}

model UserProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bio                   String?
  company               String?
  website               String?
  location              String?
  
  // Settings
  timezone              String    @default("UTC")
  language              String    @default("en")
  theme                 String    @default("light") // light, dark, system
  notifications         Boolean   @default(true)
  emailUpdates          Boolean   @default(true)
  
  // Usage
  storageUsed           Int       @default(0) // bytes
  apiCallsThisMonth     Int       @default(0)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ============================================================================
// AUTHENTICATION & TOKENS
// ============================================================================

model VerificationToken {
  id                    String    @id @default(cuid())
  email                 String
  token                 String    @unique
  type                  String    // email_verification, password_reset
  expiresAt             DateTime
  
  createdAt             DateTime  @default(now())
  
  @@unique([email, type])
  @@index([token])
}

model Session {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  token                 String    @unique
  userAgent             String?
  ipAddress             String?
  
  expiresAt             DateTime
  createdAt             DateTime  @default(now())
  
  @@index([userId])
  @@index([token])
}

// ============================================================================
// RESUMES
// ============================================================================

model Resume {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title                 String
  slug                  String    @unique
  templateId            String
  template              Template  @relation(fields: [templateId], references: [id])
  
  // Content sections
  personal              PersonalInfo?
  experience            Experience[]
  education             Education[]
  skills                Skill[]
  projects              Project[]
  certifications        Certification[]
  languages             Language[]
  
  // Additional content
  summary               String?
  awards                String[]  @default([])
  references            String[]  @default([])
  
  // Metadata
  status                String    @default("draft") // draft, published, archived
  isPublic              Boolean   @default(false)
  shareToken            String?   @unique
  
  // Statistics
  downloads             Int       @default(0)
  views                 Int       @default(0)
  
  // Versioning & History
  version               Int       @default(1)
  history               ResumeHistory[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([userId])
  @@index([slug])
  @@index([shareToken])
  @@index([status])
}

model PersonalInfo {
  id                    String    @id @default(cuid())
  resumeId              String    @unique
  resume                Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  firstName             String
  lastName              String
  email                 String
  phone                 String
  location              String
  website               String?
  linkedin              String?
  github                String?
  twitter               String?
  avatar                String?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Experience {
  id                    String    @id @default(cuid())
  resumeId              String
  resume                Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  company               String
  position              String
  startDate             String
  endDate               String?
  current               Boolean   @default(false)
  description           String?
  achievements          String[]  @default([])
  location              String?
  
  order                 Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([resumeId])
}

model Education {
  id                    String    @id @default(cuid())
  resumeId              String
  resume                Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  institution           String
  degree                String
  field                 String
  startDate             String
  endDate               String?
  gpa                   String?
  honors                String[]  @default([])
  description           String?
  
  order                 Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([resumeId])
}

model Skill {
  id                    String    @id @default(cuid())
  resumeId              String
  resume                Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  name                  String
  level                 String    @default("intermediate") // beginner, intermediate, advanced, expert
  category              String?
  endorse               Int       @default(0)
  
  order                 Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([resumeId])
}

model Project {
  id                    String    @id @default(cuid())
  resumeId              String
  resume                Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  name                  String
  description           String?
  technologies          String[]  @default([])
  link                  String?
  image                 String?
  startDate             String?
  endDate               String?
  
  order                 Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([resumeId])
}

model Certification {
  id                    String    @id @default(cuid())
  resumeId              String
  resume                Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  name                  String
  issuer                String
  date                  String
  expiryDate            String?
  link                  String?
  
  order                 Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([resumeId])
}

model Language {
  id                    String    @id @default(cuid())
  resumeId              String
  resume                Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  name                  String
  proficiency           String    @default("professional") // native, fluent, professional, basic
  
  order                 Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([resumeId])
}

model ResumeHistory {
  id                    String    @id @default(cuid())
  resumeId              String
  resume                Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  version               Int
  content               Json // Entire resume content snapshot
  changeLog             String?
  
  createdAt             DateTime  @default(now())
  
  @@index([resumeId])
}

// ============================================================================
// TEMPLATES
// ============================================================================

model Template {
  id                    String    @id @default(cuid())
  createdById           String
  createdBy             User      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  
  name                  String
  slug                  String    @unique
  category              String
  
  // Configuration
  layout                String    // Layout type ID
  blocks                Json      // Block configuration
  theme                 ThemeConfig @relation(fields: [themeId], references: [id])
  themeId               String
  
  // Media
  thumbnail             String
  preview               String?
  
  // Features & Classification
  isPremium             Boolean   @default(false)
  isATS                 Boolean   @default(false)
  isRTL                 Boolean   @default(false)
  isDarkVersion         Boolean   @default(false)
  
  // Statistics
  downloads             Int       @default(0)
  uses                  Int       @default(0)
  rating                Float     @default(0)
  reviewCount           Int       @default(0)
  
  // Content
  resumes               Resume[]
  favorites             FavoriteTemplate[]
  reviews               TemplateReview[]
  
  // Versioning
  version               Int       @default(1)
  status                String    @default("active") // active, draft, archived
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([slug])
  @@index([category])
  @@index([isPremium])
  @@index([status])
}

model ThemeConfig {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  
  // Colors
  primary               String
  secondary             String
  accent                String
  background            String
  text                  String
  textMuted             String
  border                String
  
  // Typography
  fontFamily            String
  fontSizeBase          Int
  lineHeight            Float
  
  // Spacing & Styling
  borderRadius          String
  shadowStyle           String?
  
  // Customization
  customCss             String?
  
  templates             Template[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([slug])
}

model TemplateReview {
  id                    String    @id @default(cuid())
  templateId            String
  template              Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  rating                Int       // 1-5
  review                String?
  helpful               Int       @default(0)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([templateId])
}

model FavoriteTemplate {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  templateId            String
  template              Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime  @default(now())
  
  @@unique([userId, templateId])
  @@index([userId])
}

// ============================================================================
// SUBSCRIPTIONS & PAYMENTS
// ============================================================================

model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  plan                  String    // free, pro, premium
  status                String    @default("active") // active, canceled, expired, paused
  
  // Stripe Integration
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  
  // Billing
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  canceledAt            DateTime?
  
  // Features
  features              String[]  @default([])
  
  // Limits
  resumes               Int       @default(3)
  storage               Int       @default(100) // MB
  aiCredits             Int       @default(10)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([userId])
  @@index([stripeSubscriptionId])
}

model Payment {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  amount                Int       // in cents
  currency              String    @default("USD")
  status                String    @default("pending") // pending, completed, failed, refunded
  
  // Stripe Integration
  stripePaymentId       String?   @unique
  stripeInvoiceId       String?
  
  // Details
  description           String?
  metadata              Json?
  invoiceUrl            String?
  
  // Refund
  refundedAt            DateTime?
  refundReason          String?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([userId])
  @@index([stripePaymentId])
  @@index([status])
}

model Coupon {
  id                    String    @id @default(cuid())
  code                  String    @unique
  
  type                  String    // percentage, fixed
  value                 Int       // percentage (0-100) or amount in cents
  
  maxUses               Int?
  currentUses           Int       @default(0)
  
  validFrom             DateTime
  validUntil            DateTime
  active                Boolean   @default(true)
  
  description           String?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([code])
}

// ============================================================================
// ACTIVITY & ANALYTICS
// ============================================================================

model ActivityLog {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  action                String    // resume_created, resume_downloaded, etc.
  resource              String?   // resource type (resume, template, etc.)
  resourceId            String?   // resource ID
  details               Json?
  
  ipAddress             String?
  userAgent             String?
  
  createdAt             DateTime  @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Analytics {
  id                    String    @id @default(cuid())
  date                  DateTime  @unique
  
  // Users
  totalUsers            Int       @default(0)
  newUsers              Int       @default(0)
  activeUsers           Int       @default(0)
  
  // Subscriptions
  activeSubscriptions   Int       @default(0)
  newSubscriptions      Int       @default(0)
  churnedUsers          Int       @default(0)
  
  // Revenue
  revenue               Int       @default(0) // in cents
  refunds               Int       @default(0)
  
  // Content
  resumesCreated        Int       @default(0)
  templatesUsed         Int       @default(0)
  
  // Downloads
  totalDownloads        Int       @default(0)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([date])
}

// ============================================================================
// CMS & BLOG
// ============================================================================

model BlogPost {
  id                    String    @id @default(cuid())
  slug                  String    @unique
  
  title                 String
  excerpt               String?
  content               String
  image                 String?
  
  category              String
  tags                  String[]  @default([])
  
  published             Boolean   @default(false)
  publishedAt           DateTime?
  
  seo                   BlogPostSEO?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([slug])
  @@index([published])
  @@index([category])
}

model BlogPostSEO {
  id                    String    @id @default(cuid())
  postId                String    @unique
  post                  BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  metaTitle             String?
  metaDescription       String?
  keywords              String[]  @default([])
  ogImage               String?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ============================================================================
// SUPPORT & ADMIN
// ============================================================================

model SupportTicket {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject               String
  message               String
  category              String
  priority              String    @default("normal") // low, normal, high, urgent
  status                String    @default("open") // open, in_progress, resolved, closed
  
  attachment            String?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  resolvedAt            DateTime?
  
  @@index([userId])
  @@index([status])
}

// ============================================================================
// SYSTEM CONFIGURATION
// ============================================================================

model SystemConfig {
  id                    String    @id @default("system")
  
  // Branding
  appName               String    @default("ResumeBuilder")
  logo                  String?
  favicon               String?
  primaryColor          String    @default("#3B82F6")
  
  // Settings
  maintenanceMode       Boolean   @default(false)
  registrationOpen      Boolean   @default(true)
  
  // Limits
  maxUploadSize         Int       @default(10485760) // 10MB
  maxStoragePerUser     Int       @default(1073741824) // 1GB
  
  // Features
  enableAI              Boolean   @default(true)
  enableTemplateStore   Boolean   @default(true)
  enableSocialShare     Boolean   @default(true)
  
  updatedAt             DateTime  @updatedAt
}
