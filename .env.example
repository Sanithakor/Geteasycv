# ==============================================================================
# GETEASYCV ENVIRONMENT VARIABLES CONFIGURATION REFERENCE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY (REQUIRED)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname"
DIRECT_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="your-strong-random-jwt-secret-min-32-characters"
NEXT_PUBLIC_APP_URL="https://www.geteasycv.com"
NEXT_PUBLIC_API_URL="https://www.geteasycv.com/api"
ADMIN_EMAIL="info@geteasycv.com"

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH AUTHENTICATION (REQUIRED FOR GOOGLE LOGIN)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (REQUIRED FOR PAYMENTS)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ------------------------------------------------------------------------------
# 4. AI RESUME WRITING ASSISTANT (REQUIRED FOR AI FEATURES)
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx"
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATIONS (REQUIRED FOR WELCOME & TRANSACTIONAL EMAILS)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="GetEasyCV <noreply@geteasycv.com>"

# ------------------------------------------------------------------------------
# 6. GITHUB OAUTH AUTHENTICATION (OPTIONAL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ------------------------------------------------------------------------------
# 7. SMS / OTP PROVIDERS (OPTIONAL)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
FAST2SMS_API_KEY="your-fast2sms-api-key"

# ------------------------------------------------------------------------------
# 8. FEATURE FLAGS & SECURITY TUNING (OPTIONAL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_AI_ENABLED="true"
NEXT_PUBLIC_PAYMENTS_ENABLED="true"
BCRYPT_ROUNDS="10"
