# ============================================================
# GetEasyCV — Environment Variables
# Copy this file to .env.local and fill in your values.
# All variables marked REQUIRED must be set for the app to work.
# ============================================================

# ─── Database (REQUIRED) ────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, PlanetScale, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct connection URL for Prisma migrations (bypasses connection pooling)
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── Authentication (REQUIRED) ──────────────────────────────
# Strong random secret for JWT signing — minimum 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET="your-strong-random-secret-here"

# ─── App URL (REQUIRED) ─────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://geteasycv.com"

# ─── Google OAuth (Optional) ────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Razorpay Payments (Optional) ───────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ─── OpenAI (Optional) ──────────────────────────────────────
# Required for AI resume assistance features
OPENAI_API_KEY="sk-proj-..."

# ─── Email / Resend (Optional) ──────────────────────────────
# Required for transactional emails (welcome, password reset, etc.)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="GetEasyCV <noreply@geteasycv.com>"

# ─── Admin Seed (Optional) ──────────────────────────────────
# Used to auto-create the first admin account on first deploy
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourStrongAdminPassword123!"

# ─── Feature Flags (Optional) ───────────────────────────────
# Set to "true" to enable coming soon mode
COMING_SOON_MODE="false"

# ─── BCrypt (Optional) ──────────────────────────────────────
# Number of salt rounds for password hashing (default: 10)
BCRYPT_ROUNDS="10"
